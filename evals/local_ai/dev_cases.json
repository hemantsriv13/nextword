  {
   "id": "H3-unicode",
   "split": "holdout",
   "covers": "Unicode characters",
   "corpus": "unicode",
   "prompt": "caf",
   "length": 4,
   "seed": 3,
   "focus": {
    "stage": "probs",
    "context": "f"
   },
   "action": "explain",
   "checks": [
    {
     "kind": "row",
     "top": 2
    },
    {
     "kind": "text",
